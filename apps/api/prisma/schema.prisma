// WellSpring POS/Inventory — Prisma Schema
// Generated from RFP requirements (FR-01 to FR-13)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum UserRole {
  CASHIER
  STORE_SUPERVISOR
  PHARMACIST
  INVENTORY_STAFF
  PURCHASING_OFFICER
  BRANCH_MANAGER
  HEAD_OFFICE_MANAGER
  SYSTEM_ADMIN
}

enum PaymentMethod {
  CASH
  CARD
  E_WALLET
  INSTALLMENT
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum POStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum GRNStatus {
  PENDING
  RECEIVED
  DISCREPANT
}

enum StockMovementType {
  SALE
  RETURN
  RECEIPT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  EXPIRY
  DAMAGE
}

enum QualityCheck {
  PASSED
  FAILED
  PENDING
}

enum TransferStatus {
  PENDING
  APPROVED
  SHIPPED
  RECEIVED
  CANCELLED
}

enum CountReasonCode {
  DAMAGE
  THEFT
  EXPIRY
  MISCOUNT
  TRANSFER
  OTHER
}

enum CustomerType {
  REGULAR
  SENIOR
  PWD
  LOYALTY
}

// ============ CORE MODELS ============

model Branch {
  id        String   @id @default(uuid())
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(100)
  address   String   @db.VarChar(255)
  phone     String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  stockLevels   StockLevel[]
  sales         Sale[]
  purchaseOrders PurchaseOrder[]
  grns          GRN[]
  stockCounts   StockCount[]
  transfersFrom StockTransfer[] @relation("FromBranch")
  transfersTo   StockTransfer[] @relation("ToBranch")
  auditLogs     AuditLog[]

  @@index([code])
  @@index([isActive])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique @db.VarChar(100)
  passwordHash String @db.VarChar(255)
  name      String   @db.VarChar(100)
  role      UserRole
  branchId  String?  @db.VarChar(36)
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch       Branch?      @relation(fields: [branchId], references: [id])
  sales        Sale[]       @relation("CashierSales")
  grns         GRN[]        @relation("ReceivedBy")
  stockCounts  StockCount[] @relation("CountedBy")
  transfersReq StockTransfer[] @relation("RequestedBy")
  transfersApp StockTransfer[] @relation("ApprovedBy")
  transfersShip StockTransfer[] @relation("ShippedBy")
  transfersRecv StockTransfer[] @relation("ReceivedBy")
  auditLogs    AuditLog[]

  @@index([email])
  @@index([branchId])
  @@index([role])
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  parentId    String?  @db.VarChar(36)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]  @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
}

model Product {
  id                 String   @id @default(uuid())
  sku                String   @unique @db.VarChar(50)
  barcode            String?  @unique @db.VarChar(50)
  name               String   @db.VarChar(200)
  description        String?  @db.Text
  categoryId         String   @db.VarChar(36)
  unitOfMeasure      String   @db.VarChar(20)
  standardPrice      Decimal  @db.Decimal(12, 2)
  costPrice          Decimal  @db.Decimal(12, 2)
  isPrescriptionOnly Boolean  @default(false)
  isControlledDrug   Boolean  @default(false)
  isBatchTracked     Boolean  @default(true)
  reorderPoint       Int      @default(10)
  safetyStock        Int      @default(5)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  batches       ProductBatch[]
  stockLevels   StockLevel[]
  saleItems     SaleItem[]
  poItems       POItem[]
  grnItems      GRNItem[]
  transferItems TransferItem[]
  stockCounts   StockCount[]

  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([isActive])
}

model ProductBatch {
  id               String   @id @default(uuid())
  productId        String   @db.VarChar(36)
  batchNumber      String   @db.VarChar(50)
  expiryDate       DateTime @db.Date
  manufacturingDate DateTime? @db.Date
  supplierId       String?  @db.VarChar(36)
  receivedDate     DateTime @db.Date
  createdAt        DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id])
  stockLevels StockLevel[]
  saleItems SaleItem[]
  grnItems GRNItem[]
  stockCounts StockCount[]
  transferItems TransferItem[]

  @@unique([productId, batchNumber])
  @@index([expiryDate])
  @@index([productId])
}

model StockLevel {
  id               String   @id @default(uuid())
  productId        String   @db.VarChar(36)
  branchId         String   @db.VarChar(36)
  batchId          String?  @db.VarChar(36)
  quantityOnHand   Int      @default(0)
  quantityCommitted Int     @default(0)
  quantityAvailable Int     @default(0)
  lastUpdated      DateTime @default(now()) @updatedAt

  product Product  @relation(fields: [productId], references: [id])
  branch  Branch   @relation(fields: [branchId], references: [id])
  batch   ProductBatch? @relation(fields: [batchId], references: [id])

  @@unique([productId, branchId, batchId])
  @@index([branchId])
  @@index([productId])
}

model Sale {
  id                  String       @id @default(uuid())
  branchId            String       @db.VarChar(36)
  cashierId           String       @db.VarChar(36)
  status              OrderStatus  @default(PENDING)
  subtotal            Decimal      @db.Decimal(12, 2)
  discountTotal       Decimal      @default(0) @db.Decimal(12, 2)
  taxTotal            Decimal      @default(0) @db.Decimal(12, 2)
  grandTotal          Decimal      @db.Decimal(12, 2)
  paymentMethod       PaymentMethod
  paymentReference    String?      @db.VarChar(100)
  customerName        String?      @db.VarChar(100)
  customerType        CustomerType?
  loyaltyPointsEarned Int          @default(0)
  loyaltyPointsRedeemed Int        @default(0)
  receiptNumber       String       @db.VarChar(50)
  receiptSerial       String       @unique @db.VarChar(50)
  isOffline           Boolean      @default(false)
  syncedAt            DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  branch      Branch     @relation(fields: [branchId], references: [id])
  cashier     User       @relation("CashierSales", fields: [cashierId], references: [id])
  items       SaleItem[]

  @@index([branchId])
  @@index([cashierId])
  @@index([createdAt])
  @@index([status])
  @@index([receiptSerial])
}

model SaleItem {
  id             String   @id @default(uuid())
  saleId         String   @db.VarChar(36)
  productId      String   @db.VarChar(36)
  batchId        String?  @db.VarChar(36)
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  taxRate        Decimal  @default(0.12) @db.Decimal(5, 4)
  lineTotal      Decimal  @db.Decimal(12, 2)
  isPrescription Boolean  @default(false)
  prescriptionId String?  @db.VarChar(36)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  batch   ProductBatch? @relation(fields: [batchId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Supplier {
  id              String   @id @default(uuid())
  code            String   @unique @db.VarChar(20)
  name            String   @db.VarChar(200)
  contactPerson   String?  @db.VarChar(100)
  email           String?  @db.VarChar(100)
  phone           String?  @db.VarChar(20)
  address         String?  @db.VarChar(255)
  paymentTerms    String?  @db.VarChar(50)
  leadTimeDays    Int      @default(7)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  grns           GRN[]

  @@index([code])
  @@index([isActive])
}

model PurchaseOrder {
  id            String   @id @default(uuid())
  poNumber      String   @unique @db.VarChar(50)
  supplierId    String   @db.VarChar(36)
  branchId      String   @db.VarChar(36)
  status        POStatus @default(DRAFT)
  orderDate     DateTime @db.Date
  expectedDate  DateTime? @db.Date
  subtotal      Decimal  @db.Decimal(12, 2)
  taxTotal      Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal  @db.Decimal(12, 2)
  notes         String?  @db.Text
  createdBy     String   @db.VarChar(36)
  approvedBy    String?  @db.VarChar(36)
  approvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  branch     Branch    @relation(fields: [branchId], references: [id])
  items      POItem[]
  grns       GRN[]

  @@index([supplierId])
  @@index([branchId])
  @@index([status])
  @@index([orderDate])
}

model POItem {
  id              String   @id @default(uuid())
  poId            String   @db.VarChar(36)
  productId       String   @db.VarChar(36)
  quantityOrdered Int
  quantityReceived Int     @default(0)
  unitCost        Decimal  @db.Decimal(12, 2)
  taxRate         Decimal  @default(0.12) @db.Decimal(5, 4)
  lineTotal       Decimal  @db.Decimal(12, 2)

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
  grnItems GRNItem[]

  @@index([poId])
  @@index([productId])
}

model GRN {
  id           String   @id @default(uuid())
  grnNumber    String   @unique @db.VarChar(50)
  poId         String   @db.VarChar(36)
  branchId     String   @db.VarChar(36)
  supplierId   String   @db.VarChar(36)
  status       GRNStatus @default(PENDING)
  receivedDate DateTime @db.Date
  receivedBy   String   @db.VarChar(36)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  po       PurchaseOrder @relation(fields: [poId], references: [id])
  branch   Branch        @relation(fields: [branchId], references: [id])
  supplier Supplier      @relation(fields: [supplierId], references: [id])
  receivedByUser User   @relation("ReceivedBy", fields: [receivedBy], references: [id])
  items    GRNItem[]

  @@index([poId])
  @@index([branchId])
  @@index([supplierId])
  @@index([receivedDate])
}

model GRNItem {
  id              String      @id @default(uuid())
  grnId           String      @db.VarChar(36)
  poItemId        String      @db.VarChar(36)
  productId       String      @db.VarChar(36)
  batchId         String?     @db.VarChar(36)
  batchNumber     String      @db.VarChar(50)
  expiryDate      DateTime    @db.Date
  quantityReceived Int
  unitCost        Decimal     @db.Decimal(12, 2)
  qualityCheck    QualityCheck @default(PENDING)
  notes           String?     @db.VarChar(500)

  grn     GRN     @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem  POItem  @relation(fields: [poItemId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  batch   ProductBatch? @relation(fields: [batchId], references: [id])

  @@index([grnId])
  @@index([poItemId])
  @@index([productId])
}

model StockCount {
  id             String        @id @default(uuid())
  branchId       String        @db.VarChar(36)
  productId      String        @db.VarChar(36)
  batchId        String?       @db.VarChar(36)
  systemQuantity Int
  actualQuantity Int
  variance       Int
  reasonCode     CountReasonCode?
  notes          String?       @db.VarChar(500)
  countedBy      String        @db.VarChar(36)
  approvedBy     String?       @db.VarChar(36)
  countedAt      DateTime      @db.Timestamp(6)
  createdAt      DateTime      @default(now())

  branch   Branch   @relation(fields: [branchId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
  batch    ProductBatch? @relation(fields: [batchId], references: [id])
  countedByUser User  @relation("CountedBy", fields: [countedBy], references: [id])

  @@index([branchId])
  @@index([productId])
  @@index([countedAt])
}

model StockTransfer {
  id           String         @id @default(uuid())
  transferNumber String       @unique @db.VarChar(50)
  fromBranchId String         @db.VarChar(36)
  toBranchId   String         @db.VarChar(36)
  status       TransferStatus @default(PENDING)
  requestedBy  String         @db.VarChar(36)
  approvedBy   String?        @db.VarChar(36)
  shippedBy    String?        @db.VarChar(36)
  receivedBy   String?        @db.VarChar(36)
  requestedAt  DateTime       @db.Timestamp(6)
  approvedAt   DateTime?
  shippedAt    DateTime?
  receivedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  fromBranch Branch @relation("FromBranch", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("ToBranch", fields: [toBranchId], references: [id])
  reqBy      User   @relation("RequestedBy", fields: [requestedBy], references: [id])
  appBy      User?  @relation("ApprovedBy", fields: [approvedBy], references: [id])
  shipBy     User?  @relation("ShippedBy", fields: [shippedBy], references: [id])
  recvBy     User?  @relation("ReceivedBy", fields: [receivedBy], references: [id])
  items      TransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
}

model TransferItem {
  id          String   @id @default(uuid())
  transferId  String   @db.VarChar(36)
  productId   String   @db.VarChar(36)
  batchId     String?  @db.VarChar(36)
  quantity    Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
  batch    ProductBatch? @relation(fields: [batchId], references: [id])

  @@index([transferId])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @db.VarChar(36)
  branchId  String?  @db.VarChar(36)
  action    String   @db.VarChar(100)
  entityType String  @db.VarChar(50)
  entityId  String?  @db.VarChar(100)
  before    Json?
  after     Json?
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([userId])
  @@index([branchId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
# WellSpring POS/Inventory — API Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wellspring?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="8h"

# Server
PORT=3001
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Optional: External services
# PAYMENT_GATEWAY_URL=""
# ACCOUNTING_API_URL=""
# ACCOUNTING_API_KEY=""